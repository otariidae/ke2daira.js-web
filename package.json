{
  "name": "ke2daira.js-web",
  "version": "0.1.0",
  "description": "ke2daira.js for Web",
  "dependencies": {
    "ke2daira": "^0.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.12",
    "@rsbuild/plugin-node-polyfill": "^1.4.6",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslint/core": "^0.9.5",
    "@rstest/core": "^0.12.3",
    "@rstest/playwright": "^0.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.1.2",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.64.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "rsbuild build",
    "start": "serve dist -l 3000 -n -L",
    "dev": "rsbuild dev",
    "test": "rstest --project unit",
    "test:e2e": "rstest --project e2e",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint \"src/**/*.test.{ts,tsx}\"",
    "lint:prettier": "prettier . --check",
    "lint:rslint": "rslint --type-check .",
    "fix": "run-s fix:rslint fix:eslint fix:prettier",
    "fix:rslint": "rslint --fix .",
    "fix:eslint": "eslint --fix \"src/**/*.test.{ts,tsx}\"",
    "fix:prettier": "prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/otariidae/ke2daira.js-web.git"
  },
  "author": "otariidae",
  "bugs": {
    "url": "https://github.com/otariidae/ke2daira.js-web/issues"
  },
  "homepage": "https://github.com/otariidae/ke2daira.js-web",
  "private": true,
  "license": "MIT"
}
